# Diversified-ensemble defender: ember_gbdt (EMBER-2381) OR rf_adv (NFS).
# Heavier than the single-model image (ships lightgbm + scikit-learn + lief + the
# EMBER extractor) but still CPU-only and well within the 1 GB / 5 s budget.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    DF_EMBER_MODEL=/app/models/ember_gbdt/ember_gbdt.txt \
    DF_RF_DIR=/app/models/rf_adv \
    DF_STACK_WE=6.73086 \
    DF_STACK_WR=9.25215 \
    DF_STACK_B=-5.41572 \
    DF_STACK_T=2.68843 \
    DF_HOST=0.0.0.0 \
    DF_PORT=8080

WORKDIR /app

# LightGBM needs the OpenMP runtime (libgomp), absent in slim images.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.ensemble.txt ./
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.ensemble.txt \
 && pip install --no-cache-dir --no-deps \
      "https://github.com/elastic/ember/archive/refs/heads/master.tar.gz" \
 && groupadd -r defender \
 && useradd --no-log-init -r -g defender -u 10001 defender

COPY defender/ ./defender/
COPY models/rf_adv ./models/rf_adv
COPY models/ember_gbdt ./models/ember_gbdt
COPY LICENSE.upstream ./LICENSE.upstream

USER 10001
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2).status==200 else 1)"]

CMD ["python", "-m", "defender.ensemble_server"]

# Build:  docker build -f Dockerfile.ensemble -t mlsec-defender:ensemble .
# Run:    docker run --rm -m 1g -p 8080:8080 mlsec-defender:ensemble
